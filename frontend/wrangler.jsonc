{
  "$schema": "node_modules/wrangler/config-schema.json",
  // HRP Digital Marketing Studio frontend: static React build + a small Worker that forwards /api, /r, /l and /f
  // to the Cloud Run API with the X-Origin-Verify secret. Deployed by .github/workflows/deploy.yml.
  "name": "dm-frontend",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "vars": { "API_ORIGIN": "http://127.0.0.1:8600" },
  "env": {
    "uat": {
      "name": "dm-frontend-uat",
      "routes": [{ "pattern": "uat-dm.hrpai.in", "custom_domain": true }],
      // set by the deploy workflow from the GitHub environment variable API_ORIGIN (the Cloud Run URL)
      "vars": { "API_ORIGIN": "" }
    },
    "production": {
      "name": "dm-frontend-prod",
      "routes": [{ "pattern": "dm.hrpai.in", "custom_domain": true }],
      "vars": { "API_ORIGIN": "" }
    }
  }
}
