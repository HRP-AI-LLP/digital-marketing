# HRP Digital Marketing Studio - local settings.
# start.ps1 copies this to .env on first run and fills in the __PLACEHOLDERS__ with random secrets.
# Never commit .env.

ENVIRONMENT=local

# Local ports for the API and the web app (change if something else uses them)
API_PORT=8600
WEB_PORT=5180

# PostgreSQL (Podman container hrp-dm-postgres) and Redis (hrp-dm-redis)
DB_PORT=5433
REDIS_PORT=6380
DB_OWNER_PASSWORD=__DB_OWNER_PASSWORD__
DB_APP_PASSWORD=__DB_APP_PASSWORD__
# The app connects as dm_app (not a superuser) so row-level security isolates tenants.
DATABASE_URL=postgresql+asyncpg://dm_app:__DB_APP_PASSWORD__@localhost:5433/digital_marketing
MIGRATION_DATABASE_URL=postgresql+asyncpg://dm_owner:__DB_OWNER_PASSWORD__@localhost:5433/digital_marketing
REDIS_URL=redis://localhost:6380/0

# Signs access tokens. Changing it signs everyone out.
SECRET_KEY=__SECRET_KEY__
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# First platform administrator, created on the very first start only.
PLATFORM_ADMIN_EMAIL=admin@hrpai.in
PLATFORM_ADMIN_NAME=Prashant
PLATFORM_ADMIN_PASSWORD=__ADMIN_PASSWORD__

# First organization (tenant), created on the very first start only.
DEFAULT_ORG_NAME=HRP AI LLP
DEFAULT_ORG_SLUG=hrp-ai
DEFAULT_TIMEZONE=Asia/Kolkata

CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Public HTTPS address through a Cloudflare Tunnel (docs/SETUP_SOCIAL.md, "HTTPS address").
# Meta (Facebook, Instagram, Threads) and Pinterest need it for sign-in; Instagram, Threads and Business
# Profile also fetch media from it. Only sign-in callbacks and signed media links are reachable through it.
PUBLIC_BASE_URL=
CLOUDFLARE_TUNNEL_TOKEN=

